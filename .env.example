# Copy this file to .env and fill in real values. .env is gitignored, so your keys never get committed.

# The Odds API (the-odds-api.com) — free tier key works for development
ODDS_API_KEY=

# FantasyPros ECR API (fantasypros.com/api-data)
FANTASYPROS_API_KEY=

# Anthropic API (console.anthropic.com) — powers the Ask tab.
# Optional: without it the Ask page shows a "not configured" notice and the
# endpoint returns 503. Everything else on the site works normally.
ANTHROPIC_API_KEY=

# League scoring format: half_ppr | standard | full_ppr
SCORING_FORMAT=half_ppr

# Secret token required to trigger POST /refresh (guards paid Odds API credits
# from anyone who finds the URL). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and send it back as an X-Refresh-Token header on every /refresh request.
REFRESH_SECRET=
