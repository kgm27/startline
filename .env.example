# Copy this file to .env and fill in real values. .env is gitignored, so your keys never get committed.

# The Odds API (the-odds-api.com) — free tier key works for development
ODDS_API_KEY=

# FantasyPros ECR API (fantasypros.com/api-data)
FANTASYPROS_API_KEY=

# League scoring format: half_ppr | standard | full_ppr
SCORING_FORMAT=half_ppr
